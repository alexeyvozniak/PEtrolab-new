{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petrolab.local/schemas/portable-project-manifest.schema.json",
  "title": "Portable Project Manifest",
  "description": "Integrity manifest for a safe .petrolab export and restore.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "project_id", "project_schema_version", "scope", "exported_at", "application_version", "files", "entity_counts", "omissions"],
  "properties": {
    "manifest_version": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "format": "uuid"},
    "project_schema_version": {"type": "integer", "minimum": 1},
    "scope": {"type": "string", "enum": ["project", "project_sources", "full"]},
    "exported_at": {"type": "string", "format": "date-time"},
    "application_version": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "role"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "enum": ["database", "source", "media_original", "media_optimized", "manifest_attachment"]}
        }
      }
    },
    "entity_counts": {"type": "object"},
    "omissions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
