{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petrolab.local/schemas/edit-draft.schema.json",
  "title": "Edit Draft",
  "description": "Recoverable proposed edits that are not Measurements until an explicit conflict-checked commit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "source_id", "source_fingerprint_at_start", "changes", "status", "conflict", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": ["string", "null"], "format": "uuid"},
    "source_fingerprint_at_start": {"type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{64}$"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysis_id", "field", "old_value", "new_value", "unit"],
        "properties": {
          "analysis_id": {"type": "string", "format": "uuid"},
          "field": {"type": "string", "minLength": 1},
          "old_value": {"type": ["string", "number", "boolean", "null"]},
          "new_value": {"type": ["string", "number", "boolean", "null"]},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "status": {"type": "string", "enum": ["draft", "conflict", "committed", "discarded"]},
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detected_at", "current_source_fingerprint", "current_values"],
      "properties": {
        "kind": {"type": "string", "enum": ["none", "source_changed", "value_changed", "missing_source", "mixed_ownership"]},
        "detected_at": {"type": ["string", "null"], "format": "date-time"},
        "current_source_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{64}$"},
        "current_values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["analysis_id", "field", "current_value"],
            "properties": {
              "analysis_id": {"type": "string", "format": "uuid"},
              "field": {"type": "string", "minLength": 1},
              "current_value": {"type": ["string", "number", "boolean", "null"]}
            }
          }
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
