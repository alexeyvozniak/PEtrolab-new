{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petrolab.local/schemas/media-link.schema.json",
  "title": "Media Link",
  "description": "Reversible relation between a Media Asset and a Spatial Annotation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "media_asset_id", "spatial_annotation_id", "created_by", "created_at"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "media_asset_id": {"type": "string", "format": "uuid"},
    "spatial_annotation_id": {"type": "string", "format": "uuid"},
    "caption": {"type": "string", "maxLength": 1000, "default": ""},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}

