{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petrolab.local/schemas/protocol-envelope.schema.json",
  "title": "Protocol Envelope",
  "description": "NDJSON request envelope between Tauri and the Python application service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "command",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "command": {
      "type": "string",
      "enum": [
        "project.open",
        "analysis.query",
        "selection.replace",
        "selection.union",
        "selection.subtract",
        "work_group.create",
        "plot_spec.save",
        "plot_data.query",
        "plot_visibility.hide",
        "source_filter.set",
        "import.inspect_source",
        "import.preview.window",
        "import.recipe.suggest",
        "import.recipe.revise_mapping",
        "import.recipe.revise_mappings",
        "import.recipe.revise_sections",
        "import.recipe.review_duplicates",
        "import.recipe.bulk_scopes",
        "import.recipe.apply_bulk_unit",
        "import.recipe.bulk_ignore_scopes",
        "import.recipe.apply_bulk_ignore",
        "import.recipe.validate",
        "import.plan.create",
        "import.plan.apply",
        "import.batch.rollback",
        "import.recipe.save_revision",
        "source.check_linked",
        "project.analyses.list",
        "project.last_import.retract",
        "analytical_point.create",
        "media.inspect_sources",
        "media.import.plan",
        "media.import.apply",
        "shutdown",
        "import.clean_table.classify",
        "import.workspace.create",
        "import.workspace.add_sources",
        "import.workspace.get",
        "import.workspace.preview_window",
        "import.workspace.apply_decision",
        "import.workspace.apply_bulk_decision",
        "import.workspace.replan",
        "import.workspace.commit",
        "import.workspace.discard"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
