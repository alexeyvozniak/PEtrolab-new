{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petrolab.local/schemas/protocol-envelope.schema.json",
  "title": "Protocol Envelope",
  "description": "NDJSON request envelope between Tauri and the Python application service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "command",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "command": {
      "type": "string",
      "enum": [
        "project.open",
        "project.overview",
        "analysis.query",
        "statistics.review",
        "statistics.cluster.run",
        "statistics.cluster.save_group",
        "statistics.runs.list",
        "statistics.run.open",
        "publication.catalog",
        "publication.prepare",
        "publication.export",
        "project.archive.export",
        "project.archive.check_export",
        "project.archive.inspect",
        "project.archive.restore",
        "workspace.snapshot.save",
        "workspace.snapshot.list",
        "workspace.snapshot.open",
        "workspace.template.save",
        "workspace.template.apply",
        "project.samples.list",
        "project.sample.get",
        "project.sample.context.save",
        "project.sample.note.add",
        "analytical_point.analyses",
        "analytical_point.link.set",
        "media.preview_input",
        "media.preview",
        "media.export_original",
        "media.export_rendered",
        "project.analysis.get",
        "selection.replace",
        "selection.union",
        "selection.subtract",
        "work_group.create",
        "work_group.list",
        "table_view.save",
        "table_view.list",
        "edit_draft.save",
        "edit_draft.list",
        "edit_draft.check",
        "edit_draft.commit",
        "analysis.selection.export_xlsx",
        "plot_spec.save",
        "plot_spec.list",
        "plot_spec.open",
        "plot_data.query",
        "photo.profile.query",
        "plot_data.catalog",
        "plot_visibility.hide",
        "plot_visibility.restore",
        "source_filter.set",
        "import.inspect_source",
        "import.preview.window",
        "import.recipe.suggest",
        "import.recipe.revise_mapping",
        "import.recipe.revise_mappings",
        "import.recipe.revise_sections",
        "import.recipe.review_duplicates",
        "import.recipe.bulk_scopes",
        "import.recipe.apply_bulk_unit",
        "import.recipe.bulk_ignore_scopes",
        "import.recipe.apply_bulk_ignore",
        "import.recipe.validate",
        "import.plan.create",
        "import.plan.apply",
        "import.batch.rollback",
        "import.recipe.save_revision",
        "source.check_linked",
        "project.analyses.list",
        "project.mineral_identification.list",
        "project.last_import.retract",
        "analytical_point.create",
        "media.inspect_sources",
        "media.import.plan",
        "media.import.apply",
        "shutdown",
        "import.clean_table.classify",
        "import.workspace.create",
        "import.workspace.restore",
        "import.workspace.add_sources",
        "import.workspace.get",
        "import.workspace.preview_window",
        "import.workspace.preview_formula",
        "import.workspace.apply_decision",
        "import.workspace.apply_bulk_decision",
        "import.workspace.replan",
        "import.workspace.commit",
        "import.workspace.discard"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
