{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petrolab.local/schemas/media-import-plan.schema.json",
  "title": "Media Import Plan",
  "description": "Validated batch of immutable image assets, manual point placements and optional photo links.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "semantic_fingerprint", "items", "warnings"],
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": 1}}}, "then": {"not": {"required": ["media_links"]}}},
    {"if": {"properties": {"schema_version": {"const": 2}}}, "then": {"required": ["media_links"]}},
    {"if": {"properties": {"schema_version": {"enum": [1, 2]}}},
     "then": {"properties": {"items": {"items": {"properties": {"thin_section_name": {"type": "string"}}}}}}}
  ],
  "$defs": {
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "x_px", "y_px"],
          "properties": {
            "kind": {"const": "point"},
            "x_px": {"type": "number", "minimum": 0},
            "y_px": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "x_px", "y_px", "width_px", "height_px"],
          "properties": {
            "kind": {"enum": ["rectangle", "square"]},
            "x_px": {"type": "number", "minimum": 0},
            "y_px": {"type": "number", "minimum": 0},
            "width_px": {"type": "number", "exclusiveMinimum": 0},
            "height_px": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "media_links": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_asset_id", "spatial_annotation_id"],
        "properties": {
          "media_asset_id": {"type": "string", "format": "uuid"},
          "spatial_annotation_id": {"type": "string", "format": "uuid"}
        }
      }
    },
    "unplaced_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analytical_point_id", "point_name", "sample_name", "thin_section_name"],
        "properties": {
          "analytical_point_id": {"type": "string", "format": "uuid"},
          "point_name": {"type": "string"},
          "sample_name": {"type": "string"},
          "thin_section_name": {"type": "string"}
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_asset_id", "source_path", "source_fingerprint", "display_name", "ownership_mode", "media_type", "mime_type", "width_px", "height_px", "sample_name", "thin_section_name", "placements"],
        "if": {"properties": {"thin_section_name": {"type": "null"}}},
        "then": {"properties": {"media_type": {"enum": ["Полевое фото", "Ручной образец"]}, "placements": {"maxItems": 0}}},
        "properties": {
          "media_asset_id": {"type": "string", "format": "uuid"},
          "source_path": {"type": "string", "minLength": 1},
          "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "display_name": {"type": "string", "minLength": 1},
          "ownership_mode": {"type": "string", "enum": ["managed_copy", "linked_external"]},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 80},
          "mime_type": {"type": "string", "pattern": "^image/"},
          "width_px": {"type": "integer", "minimum": 1},
          "height_px": {"type": "integer", "minimum": 1},
          "sample_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "thin_section_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
          "existing_media_asset_id": {
            "oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]
          },
          "sample_target": {
            "type": "object", "additionalProperties": false,
            "required": ["mode", "sample_id"],
            "properties": {
              "mode": {"enum": ["existing", "new"]},
              "sample_id": {"type": ["string", "null"], "format": "uuid"}
            },
            "if": {"properties": {"mode": {"const": "new"}}},
            "then": {"properties": {"sample_id": {"type": "null"}}},
            "else": {"properties": {"sample_id": {"type": "string"}}}
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["spatial_annotation_id", "analytical_point_id", "geometry", "cross_sample_exception_reason"],
              "properties": {
                "spatial_annotation_id": {"type": "string", "format": "uuid"},
                "analytical_point_id": {"type": "string", "format": "uuid"},
                "point_name": {"type": "string"},
                "point_sample_name": {"type": "string"},
                "geometry": {"$ref": "#/$defs/geometry"},
                "cross_sample_exception_reason": {
                  "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1000}]
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
