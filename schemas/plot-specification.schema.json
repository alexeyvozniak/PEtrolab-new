{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petrolab.local/schemas/plot-specification.schema.json",
  "title": "Plot Specification",
  "description": "Saved plot layout, scientific mappings, stable legend and reversible visibility mask.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "name",
    "input",
    "panels",
    "legend",
    "filters",
    "hidden_analysis_ids",
    "created_at",
    "updated_at"
  ],
  "$defs": {
    "measured_operand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "unit",
        "measurement_set",
        "method"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "wt.%",
            "ppm",
            "ppb"
          ]
        },
        "measurement_set": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "scale"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "measurement_set": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "type": "string",
          "enum": [
            "linear",
            "log"
          ]
        },
        "formula": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "method_id",
            "method_version",
            "method_definition_fingerprint",
            "run_ids"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "method_id": {
              "type": "string",
              "pattern": "^formula\\."
            },
            "method_version": {
              "type": "string",
              "minLength": 1
            },
            "method_definition_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "run_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "version",
            "operands"
          ],
          "properties": {
            "operation": {
              "enum": [
                "sum",
                "ratio",
                "mg_number"
              ]
            },
            "version": {
              "const": 1
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/measured_operand"
              },
              "minItems": 2,
              "maxItems": 16,
              "uniqueItems": true
            }
          },
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "ratio",
                  "mg_number"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "operands": {
                "maxItems": 2
              }
            }
          }
        },
        "manual_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false
            }
          ]
        }
      },
      "if": {
        "required": [
          "formula"
        ]
      },
      "then": {
        "required": [
          "unit",
          "method",
          "measurement_set"
        ],
        "not": {
          "required": [
            "calculation"
          ]
        },
        "properties": {
          "field": {
            "pattern": "^apfu\\..+$"
          },
          "unit": {
            "const": "APFU"
          },
          "method": {
            "const": null
          },
          "measurement_set": {
            "const": null
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "axes",
        "normalization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "binary",
            "ternary",
            "spider",
            "ree_pattern",
            "histogram"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          },
          "minItems": 1
        },
        "normalization": {
          "type": [
            "string",
            "null"
          ]
        },
        "point_style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "opacity",
            "size_scale"
          ],
          "properties": {
            "opacity": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "size_scale": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "symbol": {
              "enum": [
                "circle",
                "square",
                "triangle",
                "diamond",
                "triangle_down",
                "pentagon",
                "hexagon",
                "star",
                "plus",
                "cross",
                "circle_open",
                "square_open",
                "triangle_open",
                "diamond_open",
                "triangle_down_open",
                "pentagon_open",
                "hexagon_open",
                "star_open",
                "plus_open",
                "cross_open"
              ]
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "ree_pattern",
              "spider"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "axes": {
            "minItems": 2,
            "maxItems": 36
          },
          "normalization": {
            "enum": [
              "sun_mcdonough_1989_c1_v1",
              "sun_mcdonough_1989_mantle_diagram_v1"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "axes": {
            "maxItems": 3
          }
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "work_group_id"
          ],
          "properties": {
            "kind": {
              "const": "work_group"
            },
            "work_group_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "analysis_ids"
          ],
          "properties": {
            "kind": {
              "const": "analysis_snapshot"
            },
            "analysis_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/panel"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_by",
        "entries"
      ],
      "properties": {
        "group_by": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label",
              "color",
              "symbol"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "analysis-filter.schema.json"
      }
    },
    "hidden_analysis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "hidden_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "layers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "analysis_ids",
          "show_points",
          "opacity",
          "field"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "analysis_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "show_points": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "field": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "visible",
                  "probability"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "convex_hull",
                      "normal_probability_ellipse",
                      "gaussian_kde_v1"
                    ]
                  },
                  "visible": {
                    "type": "boolean"
                  },
                  "probability": {
                    "type": [
                      "null",
                      "number"
                    ],
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "bandwidth_x": { "type": "number", "minimum": 0.02, "maximum": 0.5 },
                  "bandwidth_y": { "type": "number", "minimum": 0.02, "maximum": 0.5 },
                  "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                  "style": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "color",
                      "fill_opacity",
                      "stroke_width"
                    ],
                    "properties": {
                      "mode": {
                        "enum": [
                          "outline",
                          "fill",
                          "both"
                        ]
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "fill_opacity": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 1
                      },
                      "stroke_width": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 4
                      }
                    }
                  }
                },
                "if": {
                  "properties": {
                    "method": {
                      "const": "gaussian_kde_v1"
                    }
                  }
                },
                "then": {
                  "required": ["bandwidth_x", "bandwidth_y", "level"],
                  "properties": {
                    "probability": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "not": {
                    "anyOf": [
                      { "required": ["bandwidth_x"] },
                      { "required": ["bandwidth_y"] },
                      { "required": ["level"] }
                    ]
                  },
                  "if": {
                    "properties": { "method": { "const": "convex_hull" } }
                  },
                  "then": {
                    "properties": { "probability": { "type": "null" } }
                  },
                  "else": {
                    "properties": {
                      "probability": { "type": "number" }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "category_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "entries",
        "assignments"
      ],
      "properties": {
        "mode": {
          "enum": [
            "sample",
            "generation",
            "mineral"
          ]
        },
        "entries": {
          "type": "array",
          "maxItems": 4001,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "count",
              "color"
            ],
            "properties": {
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "symbol": {
                "enum": [
                  "circle",
                  "square",
                  "triangle",
                  "diamond",
                  "triangle_down",
                  "pentagon",
                  "hexagon",
                  "star",
                  "plus",
                  "cross",
                  "circle_open",
                  "square_open",
                  "triangle_open",
                  "diamond_open",
                  "triangle_down_open",
                  "pentagon_open",
                  "hexagon_open",
                  "star_open",
                  "plus_open",
                  "cross_open"
                ]
              }
            }
          }
        },
        "assignments": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "photo_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_asset_id",
        "panel_ids"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["points", "axis", "reference_px", "reference_um"],
          "properties": {
            "points": {
              "type": "array", "minItems": 2, "maxItems": 100, "uniqueItems": true,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["spatial_annotation_id", "analysis_id"],
                "properties": {
                  "spatial_annotation_id": {"type": "string", "format": "uuid"},
                  "analysis_id": {"type": "string", "format": "uuid"}
                }
              }
            },
            "axis": {"type": "object", "required": ["field"]},
            "reference_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000},
            "reference_um": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000}
          }
        },
        "media_asset_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "panel_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
