{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PetroLab: validate contracts",
      "type": "shell",
      "command": "python scripts/validate_contracts.py",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "PetroLab: Python tests",
      "type": "shell",
      "command": "python -m unittest discover -s tests",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "PetroLab: UI tests",
      "type": "npm",
      "script": "test:ui",
      "path": "desktop",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "PetroLab: Sites tests",
      "type": "npm",
      "script": "test:sites",
      "path": "desktop",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "PetroLab: Tauri contract test",
      "type": "npm",
      "script": "test:tauri-contract",
      "path": "desktop",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "PetroLab: Web build",
      "type": "npm",
      "script": "build",
      "path": "desktop",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "PetroLab: Rust check",
      "type": "shell",
      "command": "cargo check",
      "options": {
        "cwd": "${workspaceFolder}/desktop/src-tauri"
      },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "PetroLab: Rust clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets --all-features -- -D warnings",
      "options": {
        "cwd": "${workspaceFolder}/desktop/src-tauri"
      },
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "PetroLab: Full verification",
      "dependsOrder": "sequence",
      "dependsOn": [
        "PetroLab: validate contracts",
        "PetroLab: Python tests",
        "PetroLab: UI tests",
        "PetroLab: Sites tests",
        "PetroLab: Tauri contract test",
        "PetroLab: Rust check",
        "PetroLab: Web build"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
